PORT=4001
PGHOST=127.0.0.1
PGPORT=5434
PGDATABASE=strength_training
PGUSER=strength_app
PGPASSWORD=replace_with_your_local_database_password

# Run npm run setup to generate a private secret and exact local/phone origins.
BETTER_AUTH_SECRET=generate_with_npm_run_setup
APP_ORIGINS=configure_with_npm_run_setup

# Hosted deployments use a separate secret and exact public HTTPS origin.
# Set these privately in the hosting dashboard, never in frontend VITE_* values.
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# APP_ORIGINS=https://YOUR-VERIFIED-SITE.vercel.app
# BETTER_AUTH_SECRET=generate_a_new_random_secret_for_production
# DATABASE_URL_UNPOOLED is for one-off migrations; do not use the pooled URL for migration locks.
